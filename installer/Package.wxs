<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="SAD SyncService"
           Manufacturer="SAD - Sociedad Argentina de Diabetes"
           Version="$(var.ProductVersion)"
           UpgradeCode="8a7e6c1a-3f4d-4f9c-9c2b-1a2b3c4d5e6f"
           Scope="perMachine"
           InstallerVersion="500">

    <SummaryInformation Description="SAD SyncService - Sincronización con Tango Gestión"/>

    <MajorUpgrade DowngradeErrorMessage="Ya hay instalada una versión más reciente de [ProductName]." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Carpeta de destino: C:\Program Files\SAD\SyncService -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="SADFolder" Name="SAD">
        <Directory Id="INSTALLFOLDER" Name="SyncService" />
      </Directory>
    </StandardDirectory>

    <!-- Atajos del menú inicio -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuSAD" Name="SAD" />
    </StandardDirectory>

    <!-- ==================== Componentes ==================== -->

    <!-- 1) Binario principal del servicio + registro como Windows Service -->
    <Component Id="SyncServiceExe" Directory="INSTALLFOLDER" Bitness="always64" Guid="*">
      <File Id="SyncServiceExeFile"
            Source="$(var.StagingDir)\SyncService.exe"
            KeyPath="yes" />

      <ServiceInstall Id="SADSyncServiceInstall"
                      Name="SADSyncService"
                      DisplayName="SAD - Tango Sync Service"
                      Description="Sincronización bidireccional entre el backend SAD Inscripciones y Tango Gestión."
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="LocalSystem"
                      Vital="yes">
        <util:ServiceConfig FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="none"
                            RestartServiceDelayInSeconds="60"
                            ResetPeriodInDays="1" />
      </ServiceInstall>

      <ServiceControl Id="SADSyncServiceControl"
                      Name="SADSyncService"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
    </Component>

    <!-- 2) ConfigTool (no es key path del servicio, va aparte) -->
    <Component Id="ConfigToolExe" Directory="INSTALLFOLDER" Bitness="always64" Guid="*">
      <File Id="ConfigToolExeFile"
            Source="$(var.StagingDir)\SyncService.ConfigTool.exe"
            KeyPath="yes" />
    </Component>

    <!-- 3) appsettings.json: NUNCA sobreescribir si el usuario ya lo configuró.
         La primera install lo copia desde el template. Upgrades lo respetan. -->
    <Component Id="AppSettingsJson" Directory="INSTALLFOLDER" Bitness="always64"
               Guid="b1c2d3e4-f5a6-4789-b0c1-d2e3f4a5b6c7"
               Permanent="no" NeverOverwrite="yes">
      <File Id="AppSettingsFile"
            Source="$(var.StagingDir)\appsettings.template.json"
            Name="appsettings.json"
            KeyPath="yes" />
    </Component>

    <!-- 4) Template de referencia (siempre actualizado) -->
    <Component Id="AppSettingsTemplate" Directory="INSTALLFOLDER" Bitness="always64" Guid="*">
      <File Id="AppSettingsTemplateFile"
            Source="$(var.StagingDir)\appsettings.template.json"
            KeyPath="yes" />
    </Component>

    <!-- 5) Atajo en el menú inicio para el ConfigTool -->
    <Component Id="ConfigToolShortcut" Directory="StartMenuSAD" Guid="*">
      <Shortcut Id="ConfigToolStartMenu"
                Name="Configurar SyncService"
                Description="Configurar credenciales y endpoints del SAD SyncService"
                Target="[INSTALLFOLDER]SyncService.ConfigTool.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveStartMenuSAD" Directory="StartMenuSAD" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\SAD\SyncService"
                     Name="ConfigShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- ==================== Feature ==================== -->
    <Feature Id="Main" Title="SAD SyncService" Level="1" Display="expand"
             ConfigurableDirectory="INSTALLFOLDER">
      <ComponentRef Id="SyncServiceExe" />
      <ComponentRef Id="ConfigToolExe" />
      <ComponentRef Id="AppSettingsJson" />
      <ComponentRef Id="AppSettingsTemplate" />
      <ComponentRef Id="ConfigToolShortcut" />

      <!-- Auto-harvest: todos los dlls, runtimes nativos, Config\*.xml, etc.
           Excluimos los archivos ya declarados como componentes con identidad explícita. -->
      <Files Directory="INSTALLFOLDER" Include="$(var.StagingDir)\**">
        <Exclude Files="$(var.StagingDir)\SyncService.exe" />
        <Exclude Files="$(var.StagingDir)\SyncService.ConfigTool.exe" />
        <Exclude Files="$(var.StagingDir)\appsettings.json" />
        <Exclude Files="$(var.StagingDir)\appsettings.template.json" />
        <Exclude Files="$(var.StagingDir)\appsettings.Development.json" />
      </Files>
    </Feature>

    <!-- ==================== UI ==================== -->
    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- ==================== Custom Action: lanzar ConfigTool al final ==================== -->
    <Property Id="LAUNCHCONFIGTOOL" Value="1" />

    <CustomAction Id="LaunchConfigTool"
                  FileRef="ConfigToolExeFile"
                  ExeCommand="--firstrun"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="LaunchConfigTool" After="InstallFinalize"
              Condition="NOT REMOVE AND LAUNCHCONFIGTOOL = &quot;1&quot;" />
    </InstallExecuteSequence>

  </Package>
</Wix>
