<Window x:Class="SyncService.ConfigTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAD SyncService - Configuración"
        Width="640" Height="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Margin" Value="0,8,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Text="Configuración del servicio SAD SyncService"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" Click="Cancel_Click" MinWidth="90"/>
            <Button Content="Guardar" Click="Save_Click" MinWidth="90"
                    Background="#5D8AC8" Foreground="White"/>
            <Button Content="Guardar y reiniciar servicio"
                    Click="SaveAndRestart_Click" MinWidth="200"
                    Background="#2E7D32" Foreground="White"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="#CCC" BorderThickness="1"
                Padding="8" Margin="0,8,0,0" Background="#F5F5F5">
            <StackPanel>
                <TextBlock Text="Estado del servicio:" FontWeight="SemiBold"/>
                <TextBlock x:Name="ServiceStatusText" Text="(verificando...)" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="SQL Server (Tango)">
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelStyle}" Text="Servidor (host[,puerto])"/>
                        <TextBox x:Name="SqlServerBox"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Base de datos"/>
                        <TextBox x:Name="SqlDatabaseBox"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Usuario"/>
                        <TextBox x:Name="SqlUserBox"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Contraseña"/>
                        <PasswordBox x:Name="SqlPasswordBox"/>

                        <CheckBox x:Name="TrustServerCertBox" Content="Trust Server Certificate"
                                  Margin="0,8,0,0" IsChecked="True"/>

                        <Button Content="Probar conexión SQL"
                                HorizontalAlignment="Left" Margin="0,10,0,0"
                                Click="TestSql_Click"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Backend API">
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelStyle}" Text="URL base (ej: http://localhost:5161)"/>
                        <TextBox x:Name="ApiBaseUrlBox"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Sync Key (X-Sync-Key)"/>
                        <TextBox x:Name="SyncKeyBox"/>

                        <Button Content="Probar API"
                                HorizontalAlignment="Left" Margin="0,10,0,0"
                                Click="TestApi_Click"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Sincronización">
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelStyle}" Text="Intervalo (minutos)"/>
                        <TextBox x:Name="IntervalBox" Width="100" HorizontalAlignment="Left"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Diagnóstico">
                    <TextBox x:Name="LogBox" Height="120" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" Background="#1E1E1E" Foreground="#D4D4D4"/>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
